# No API key is required for Open-Meteo non-commercial use.
# Kept here for forward-compatibility if a commercial/higher-rate-limit key is added later.
OPEN_METEO_API_KEY=

# Timezone used across the pipeline
TZ=Africa/Tunis

# DATA_MODE=demo allows the labelled DEMO/PROXY physics-simulation fallback.
# DATA_MODE=real REFUSES to run and raises RealDataUnavailableError if any
# required real source (weather, production) is unavailable - see
# src/ingestion/data_mode.py and docs/REAL_PRODUCTION_DATA_SOURCES.md.
DATA_MODE=demo
